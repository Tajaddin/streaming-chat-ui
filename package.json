{
  "name": "streaming-chat-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Production React + SSE chat with citations, incremental markdown, abort/regenerate, and message editing. Includes a Node SSE dev server.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --import tsx/esm src/server/server.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:ttfb": "node bench/ttfb.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.32.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "express": "^4.19.2",
    "jsdom": "^25.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
